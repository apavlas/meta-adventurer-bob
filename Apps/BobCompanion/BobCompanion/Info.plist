<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Bob</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>bobcompanion</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>fb-viewapp</string>
	</array>
	<key>MWDAT</key>
	<dict>
		<key>AppLinkURLScheme</key>
		<string>bobcompanion://</string>
		<key>MetaAppID</key>
		<string>0</string>
		<key>Analytics</key>
		<dict>
			<key>OptOut</key>
			<true/>
		</dict>
		<key>CrashReporting</key>
		<dict>
			<key>OptOut</key>
			<true/>
		</dict>
	</dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Bob uses Bluetooth so Meta Adventurer can be the hands-free microphone when the glasses are Connected.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Bob uses the microphone for Talk to Bob. Glasses Bluetooth hands-free audio is tagged hfp. This iPhone microphone is tagged phone_mic.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Bob turns speech into text for BobBridge. Glasses Bluetooth hands-free audio is tagged hfp. The iPhone microphone is tagged phone_mic.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Needed for Meta Wearables DAT device discovery on the local network.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_meta-wearable._tcp</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-peripheral</string>
		<string>external-accessory</string>
	</array>
	<key>BOB_USE_MOCK_DEVICE</key>
	<string>$(BOB_USE_MOCK_DEVICE)</string>
	<key>BOB_BRIDGE_MODE</key>
	<string>$(BOB_BRIDGE_MODE)</string>
	<key>BOB_BRIDGE_BASE_URL</key>
	<string>$(BOB_BRIDGE_BASE_URL)</string>
	<key>BOB_BRIDGE_BEARER_TOKEN</key>
	<string>$(BOB_BRIDGE_BEARER_TOKEN)</string>
	<key>UISupportedExternalAccessoryProtocols</key>
	<array>
		<string>com.meta.ar.wearable</string>
	</array>
</dict>
</plist>
